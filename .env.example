# JUNO - local configuration template.
# Copy to `.env` and fill in values. Never commit real secrets.

# Local backend token used by the CLI/TUI and local socket clients.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JUNO_API_TOKEN=

# Path to the SQLite database file. Defaults to ~/.juno/juno.db
JUNO_DATA_DIR=

# Port for the local HTTP/WebSocket API. Defaults to 4173.
JUNO_API_PORT=4173

# Bind host for the local API. Keep on loopback unless you know what you are doing.
JUNO_API_HOST=127.0.0.1

# Optional external integrations (only used when explicitly requested).
WEATHER_API_KEY=
SEARCH_API_KEY=

# Log level: debug | info | warn | error
JUNO_LOG_LEVEL=info