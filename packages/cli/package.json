{
  "name": "@juno/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "juno": "./dist/bin/juno.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/bin/juno.ts --format esm --dts --clean",
    "dev": "tsx src/bin/juno.ts",
    "tui": "tsx src/bin/juno.ts tui",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/bin/juno.js"
  },
  "dependencies": {
    "@juno/ai": "*",
    "@juno/core": "*",
    "@juno/automation": "*",
    "@juno/tui": "*",
    "commander": "^13.0.0",
    "chalk": "^5.4.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}